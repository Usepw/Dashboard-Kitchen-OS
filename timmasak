// === BULK TSV LOGIC ===
function prosesBulkTSV() {
    const rawText = document.getElementById('bulkText').value.trim();
    const actionType = document.getElementById('bulkType').value;
    if (!rawText) return alert("Teks TSV masih kosong!");
    
    const lines = rawText.split(/\r?\n/).filter(l => l.trim() !== "");
    if (lines.length < 2) return alert("Minimal butuh 1 baris header dan 1 baris data.");

    const headers = lines[0].split('\t').map(h => h.trim());
    const dataRows = [];
    
    for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split('\t');
        const obj = {};
        headers.forEach((h, idx) => { obj[h] = (cols[idx] || "").trim(); });
        dataRows.push(obj);
    }

    if (actionType === 'addStandar') {
        simpanDataBulk(actionType, { rows: dataRows });
    } else {
        // Jika resep, kita perlu ubah formatnya jadi {menu, card, items:[]} per grup
        alert("Untuk Bulk Resep, pastikan header TSV-nya adalah: Menu, Card, Item");
        // (Logika spesifik untuk resep bisa disesuaikan di sini jika perlu)
        simpanDataBulk(actionType, { rows: dataRows });
    }
}

// === KOMUNIKASI KE APPS SCRIPT ===
async function simpanData(action, payload) {
    if(APPS_SCRIPT_URL.includes("MASUKKAN_URL")) return alert("https://script.google.com/macros/s/AKfycby1k2Iwutn0QtWSPrRAsbuB3NB12aaXoO6ka2ZfUFcvuwAPYzhGfn9ueem5KWHXydzbkA/exec");
    payload.action = action;
    payload.sheetId = SHEET_ID; // Kirim Sheet ID (untuk multi-dapur)
    
    const btn = event.target; const orig = btn.innerText;
    btn.disabled = true; btn.innerText = "Menyimpan...";
    try {
        const response = await fetch(APPS_SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload) });
        const result = await response.json();
        if(result.status === "success") {
            alert("✅ Berhasil disimpan!");
            closeInputModal(); loadAll(); 
        } else { alert("❌ Gagal: " + result.message); }
    } catch (error) { alert("❌ Error: " + error.message); } 
    finally { btn.disabled = false; btn.innerText = orig; }
}

async function simpanDataBulk(action, payload) {
    if(APPS_SCRIPT_URL.includes("https://script.google.com/macros/s/AKfycby1k2Iwutn0QtWSPrRAsbuB3NB12aaXoO6ka2ZfUFcvuwAPYzhGfn9ueem5KWHXydzbkA/exec")) return alert("URL Apps Script belum diisi!");
    payload.action = "bulkInsert";
    payload.sheetName = action === 'addStandar' ? TAB_MASTER : TAB_RESEP;
    payload.sheetId = SHEET_ID;
    
    const btn = event.target; const orig = btn.innerText;
    btn.disabled = true; btn.innerText = "Memproses...";
    try {
        const response = await fetch(APPS_SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload) });
        const result = await response.json();
        if(result.status === "success") {
            alert("✅ " + result.message);
            closeInputModal(); loadAll();
        } else { alert("❌ Gagal: " + result.message); }
    } catch (error) { alert("❌ Error: " + error.message); } 
    finally { btn.disabled = false; btn.innerText = orig; }
}

// === CORE APP ===
function switchApp(app){
  CURRENT_APP = app;
  document.getElementById('btnMasak').classList.toggle('active', app==='masak');
  document.getElementById('btnPersiapan').classList.toggle('active', app==='persiapan');
  document.getElementById('pageTitle').textContent = app==='masak' ? 'Tim Masak' : 'Tim Persiapan';
  render();
}
function setTodayLabel(){
  const days = ["Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"];
  const months = ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];
  const now = new Date(); todayDayName = days[now.getDay()];
  document.getElementById('todayLabel').textContent = todayDayName + ", " + now.getDate() + " " + months[now.getMonth()] + " " + now.getFullYear();
  SELECTED_DAY_MASAK = DAYS_MASAK.includes(todayDayName) ? todayDayName : "Senin";
  SELECTED_DAY_PERSIAPAN = DAYS_PERSIAPAN.includes(todayDayName) ? todayDayName : "Minggu";
}
async function loadAll(){
  document.getElementById('content').className = 'loading'; document.getElementById('content').innerHTML = 'Memuat data...';
  try{
    const [jadwalRaw, masterRaw, resepRaw] = await Promise.all([fetchCsv(namedCsvUrl(TAB_JADWAL)), fetchCsv(namedCsvUrl(TAB_MASTER)), fetchCsv(namedCsvUrl(TAB_RESEP))]);
    CACHE_JADWAL = normalizeJadwal(jadwalRaw); 
    CACHE_MASTER = normalizeData(masterRaw); 
    CACHE_RESEP = normalizeData(resepRaw); 
    render();
  }catch(err){ document.getElementById('content').className = 'empty'; document.getElementById('content').innerHTML = '<div class="big">Gagal memuat</div>' + (err.message || err); }
}
function findMaster(namaMenu){ return !CACHE_MASTER ? null : CACHE_MASTER.find(r => (r["Nama Menu"]||"").trim().toLowerCase() === namaMenu.trim().toLowerCase()); }
function getVideoSopForMenu(menuName){
  if(!CACHE_RESEP) return { video: '', sop: '' };
  const row = CACHE_RESEP.find(r => (r['Daftar Menu Unik'] || '').trim().toLowerCase() === menuName.trim().toLowerCase());
  return { video: row ? (row['Link Video']||'').trim() : '', sop: row ? (row['Link SOP']||'').trim() : '' };
}
function render(){ if(CACHE_JADWAL) { CURRENT_APP === 'masak' ? renderMasak() : renderPersiapan(); } }

function dotsHtml(value, max){ max = max || 5; const v = parseInt(value) || 0; let html = '<div class="dots">'; for(let i=1;i<=max;i++) html += `<div class="dot ${i<=v?'filled':''}"></div>`; return html + '</div>'; }
function scaleRow(label, value){ return `<div class="scale-row"><span class="scale-label">${label}</span>${dotsHtml(value)}<span style="width:16px;text-align:right;color:var(--muted);font-size:0.8rem;font-weight:700;">${value||0}</span></div>`; }
function linkBtn(label, url, primary){ const has = validLink(url); const cls = `link-btn ${primary?'primary':''} ${has?'':'disabled'}`; return `<a class="${cls}" href="${has ? url : '#'}" target="_blank" rel="noopener">${label}</a>`; }
function renderRedFlag(val){ if(!isFilled(val)) return ''; const v = val.trim().toLowerCase(); const isWarn = v.startsWith("ada") && !v.startsWith("tidak"); return `<span class="redflag ${isWarn?'warn':'ok'}">${isWarn?'&#128681; ':''}${val.trim()}</span>`; }
function buildStdBody(m){
  if(!m) return `<div class="unavailable">Kartu Standar belum tersedia</div>`;
  return `<div class="section"><div class="section-title">&#127919; Rasa</div>${scaleRow("Asin", m["Asin (1-5)"])}${scaleRow("Manis", m["Manis (1-5)"])}${scaleRow("Pedas", m["Pedas (1-5)"])}${scaleRow("Gurih/Umami", m["Gurih/Umami (1-5)"])}${scaleRow("Asam", m["Asam (1-5)"])}</div>
    <div class="section"><div class="section-title">&#9995; Tekstur</div>${scaleRow("Kekenyalan", m["Kelembutan/Kekenyalan (1-5)"])}${scaleRow("Kebasahan", m["Kebasahan (1-5)"])}${scaleRow("Kerenyahan", m["Kerenyahan (1-5)"])}</div>
    <div class="section"><div class="section-title">&#128065; Visual</div><div class="desc-text">${isFilled(m["Warna Dominan"]) ? m["Warna Dominan"] : '<span style="color:var(--muted);font-style:italic;">Belum diisi</span>'}</div>${scaleRow("Kematangan Warna", m["Kematangan Warna (1-5)"])}</div>
    <div class="section"><div class="section-title">&#128067; Aroma</div><div class="desc-text">${isFilled(m["Aroma Dominan"]) ? m["Aroma Dominan"] : '<span style="color:var(--muted);font-style:italic;">Belum diisi</span>'}</div>${scaleRow("Intensitas", m["Intensitas Aroma (1-5)"])}${renderRedFlag(m["Red Flag Aroma"])}</div>`;
}
function buildCardShell(komponen, namaMenu, bodyHtml, vs){
  const head = `<div class="std-card-head"><div class="komponen">${komponen}</div><div class="menu-name">${namaMenu}</div></div>`;
  const links = (validLink(vs.video) || validLink(vs.sop)) ? `<div class="std-links">${linkBtn("&#9654; Video", vs.video, true)}${linkBtn("&#128196; SOP", vs.sop, false)}</div>` : '';
  return head + `<div class="std-card-body">${bodyHtml}</div>` + links;
}

function renderMasak(){
  const tabsEl = document.getElementById('dayTabs'); tabsEl.innerHTML = "";
  DAYS_MASAK.forEach(d=>{ const btn = document.createElement('button'); btn.className = 'day-tab' + (d===SELECTED_DAY_MASAK ? ' active':''); btn.innerHTML = d + (d===todayDayName ? '<span class="today-dot"></span>' : ''); btn.onclick = ()=>{ SELECTED_DAY_MASAK = d; render(); }; tabsEl.appendChild(btn); });
  const rows = CACHE_JADWAL.filter(r => (r["Hari"]||"").toLowerCase() === SELECTED_DAY_MASAK.toLowerCase() && isFilled(r["Nama Menu"]));
  const contentEl = document.getElementById('content'); document.getElementById('menuSummary').style.display = 'none';
  if(rows.length === 0){ contentEl.className = 'empty'; contentEl.innerHTML = '<div class="big">Belum ada jadwal</div>Jadwal menu untuk ' + SELECTED_DAY_MASAK + ' belum diisi.'; return; }
  contentEl.className = 'grid'; contentEl.innerHTML = '';
  rows.forEach(row=>{
    const masterRow = findMaster(row["Nama Menu"]); const vs = getVideoSopForMenu(row["Nama Menu"]);
    const el = document.createElement('div'); el.className = 'std-card';
    el.innerHTML = buildCardShell(row["Komponen"], row["Nama Menu"], buildStdBody(masterRow), vs);
    el.addEventListener('click', ()=> { document.getElementById('overlay-content').innerHTML = `<div class="modal-box" style="padding:0;max-width:520px;">${el.innerHTML}</div>`; document.getElementById('overlay').classList.add('active'); });
    contentEl.appendChild(el);
  });
}

function renderPersiapan(){
  const tabsEl = document.getElementById('dayTabs'); tabsEl.innerHTML = "";
  DAYS_PERSIAPAN.forEach(d=>{ const btn = document.createElement('button'); btn.className = 'day-tab' + (d===SELECTED_DAY_PERSIAPAN ? ' active':''); btn.innerHTML = d + (d===todayDayName ? '<span class="today-dot"></span>' : ''); btn.onclick = ()=>{ SELECTED_DAY_PERSIAPAN = d; render(); }; tabsEl.appendChild(btn); });
  const contentEl = document.getElementById('content'), menuStrip = document.getElementById('menuSummary');
  const masakDay = PERSIAPAN_TO_MASAK[SELECTED_DAY_PERSIAPAN];
  const jadwalHariIni = CACHE_JADWAL.filter(r => (r["Hari"]||"").toLowerCase() === masakDay.toLowerCase() && isFilled(r["Nama Menu"]));
  if(jadwalHariIni.length === 0){ menuStrip.style.display = 'none'; contentEl.className = 'empty'; contentEl.innerHTML = '<div class="big">Belum ada menu</div>Jadwal Tim Masak untuk ' + masakDay + ' belum diisi.'; return; }
  contentEl.className = 'grid'; contentEl.innerHTML = ''; const menuList = [];
  jadwalHariIni.forEach(j=>{
    const menuName = j["Nama Menu"].trim(); const resepMenu = CACHE_RESEP.filter(r => r.Menu && r.Menu.trim().toLowerCase() === menuName.toLowerCase());
    const vs = getVideoSopForMenu(menuName); let bodyHtml;
    if(resepMenu.length === 0){ bodyHtml = `<div class="unavailable">Resep belum ada di Master Resep Persiapan</div>`; }
    else {
      menuList.push(menuName); const byCard = {};
      resepMenu.forEach(r=>{ if(!byCard[r.Card]) byCard[r.Card] = []; byCard[r.Card].push(r.Item); });
      bodyHtml = Object.keys(byCard).map(cardName => `<div class="section"><div class="prep-card-title">${cardName}</div><ul class="items">${byCard[cardName].map(item => `<li class="item"><span class="idot"></span><span class="label">${item}</span></li>`).join('')}</ul></div>`).join('');
    }
    const cardHtml = buildCardShell(j["Komponen"], menuName, bodyHtml, vs);
    const el = document.createElement('div'); el.className = 'std-card'; el.innerHTML = cardHtml;
    el.addEventListener('click', ()=> { document.getElementById('overlay-content').innerHTML = `<div class="modal-box" style="padding:0;max-width:520px;">${cardHtml}</div>`; document.getElementById('overlay').classList.add('active'); });
    contentEl.appendChild(el);
  });
  if(menuList.length > 0){ menuStrip.style.display = 'block'; menuStrip.textContent = 'Menyiapkan untuk ' + masakDay + ': ' + menuList.join(' · '); } else { menuStrip.style.display = 'none'; }
}
function closeOverlay(){ document.getElementById('overlay').classList.remove('active'); }

document.addEventListener('DOMContentLoaded', async () => {
  document.getElementById('overlay').addEventListener('click', (e)=>{ if(e.target.id==='overlay') closeOverlay(); });
  setTodayLabel(); 
  await applyDapurConfig(); // Cek URL ?dapur=
  loadAll();
});
