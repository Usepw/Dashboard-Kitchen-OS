<script>
// === KONFIGURASI ===
const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycby1k2Iwutn0QtWSPrRAsbuB3NB12aaXoO6ka2ZfUFcvuwAPYzhGfn9ueem5KWHXydzbkA/exec"; 
const ADMIN_PASSWORD = "admincwfn";

// Sistem Multi-Dapur (SaaS)
const DEFAULT_SHEET_ID = "1x5LlGdHIPmkcbwUMeP_JGymBWCn39znsAxYoL9SmjNM";
const REGISTRY_SHEET_ID = "12NhR0KH1Q_YfeJJJNotC_o2b60Irn-Jtpo5F2DbRdyA";
let SHEET_ID = DEFAULT_SHEET_ID;

const TAB_RESEP = "Master_Resep", TAB_MASTER = "MasterKartuStandard", TAB_JADWAL = "Jadwal_Menu_Mingguan";   
const DAYS_MASAK = ["Senin","Selasa","Rabu","Kamis","Jumat"];
const DAYS_PERSIAPAN = ["Minggu","Senin","Selasa","Rabu","Kamis"];
const PERSIAPAN_TO_MASAK = {"Minggu":"Senin","Senin":"Selasa","Selasa":"Rabu","Rabu":"Kamis","Kamis":"Jumat"};

let CURRENT_APP = "persiapan", CACHE_JADWAL = [], CACHE_MASTER = [], CACHE_RESEP = [];
let SELECTED_DAY_MASAK = null, SELECTED_DAY_PERSIAPAN = null, todayDayName = "";

// === MULTI-DAPUR LOGIC ===
function namedCsvUrl(tabName, sheetId = SHEET_ID){ return "https://docs.google.com/spreadsheets/d/" + sheetId + "/gviz/tq?tqx=out:csv&sheet=" + encodeURIComponent(tabName) + "&_=" + Date.now(); }

async function applyDapurConfig() {
    const params = new URLSearchParams(window.location.search);
    const slug = params.get('dapur');
    if (!slug) return;

    try {
        const res = await fetch("https://docs.google.com/spreadsheets/d/" + REGISTRY_SHEET_ID + "/gviz/tq?tqx=out:csv&gid=0");
        const text = await res.text();
        const rows = text.split(/\r?\n/).filter(l => l.trim() !== '').map(line => {
            let s = line.trim(); if (s.startsWith('"')) s = s.slice(1); if (s.endsWith('"')) s = s.slice(0, -1);
            return s.split('","');
        });
        const headers = rows[0] || [];
        const regRows = rows.slice(1).map(cols => { const obj = {}; headers.forEach((h, i) => obj[h] = cols[i] || ''); return obj; });
        const row = regRows.find(r => (r['Slug'] || '').trim().toLowerCase() === slug.trim().toLowerCase());
        
        if (row) {
            if (row['Sistem Sheet ID']) SHEET_ID = row['Sistem Sheet ID'].trim();
            if (row['Nama Dapur']) document.getElementById('eyebrowLabel').textContent = 'CWFN · ' + row['Nama Dapur'].trim();
            if (row['Warna Identitas']) {
                const hex = row['Warna Identitas'].trim();
                if (hex.startsWith('#')) document.documentElement.style.setProperty('--gold', hex);
            }
        }
    } catch(e) { console.warn("Gagal load Registry, pakai default."); }
}

// === FETCH & PARSER ===
function fetchCsv(url){
  const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error("Koneksi lambat")), 12000));
  const fetchP = new Promise((resolve, reject) => { Papa.parse(url, { download:true, header:false, skipEmptyLines:true, complete:(res)=>resolve(res.data), error:(err)=>reject(err) }); });
  return Promise.race([fetchP, timeout]);
}
function isFilled(val){ return val && val.trim() !== "" && !val.trim().startsWith("("); }
function validLink(link){ return link && link.trim().toLowerCase().startsWith('http'); }

function normalizeJadwal(rawData) {
    const result = []; let currentHari = "";
    const HARI_LIST = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"];
    const KOMPONEN_LIST = ["Karbohidrat", "Lauk Hewani", "Lauk Nabati", "Sayur", "Sayuran"];
    rawData.forEach(rowArray => {
        const vals = rowArray.map(v => (v || "").trim());
        if (vals.find(v => HARI_LIST.includes(v))) currentHari = vals.find(v => HARI_LIST.includes(v));
        const komponen = vals[1] || "", menu = vals[2] || "";
        if (KOMPONEN_LIST.includes(komponen) && menu !== "") result.push({ "Hari": currentHari, "Komponen": komponen, "Nama Menu": menu });
    });
    return result;
}
function normalizeData(rawData) {
    if(!rawData || rawData.length < 2) return [];
    const headers = rawData[0].map(h => (h || "").trim()); const result = [];
    for(let i = 1; i < rawData.length; i++) {
        const row = {}; for(let j = 0; j < headers.length; j++) { if(headers[j] !== "") row[headers[j]] = (rawData[i][j] || "").trim(); }
        result.push(row);
    }
    return result;
}

// === ADMIN & UI LOGIC ===
function openAdminModal() { document.getElementById('adminPassword').value = ''; document.getElementById('loginModal').classList.add('active'); }
function closeLoginModal() { document.getElementById('loginModal').classList.remove('active'); }
function verifyAdmin() {
