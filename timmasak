// === SIMPAN DATA ===
function simpanJadwal() {
    const menu = document.getElementById('jMenu').value.trim();
    if (!menu) return alert("Nama menu wajib diisi!");
    
    // Cek apakah menu sudah ada di Master Resep / punya Video?
    const adaResep = CACHE_RESEP.some(r => (r.Menu||'').toLowerCase() === menu.toLowerCase());
    const vs = getVideoSopForMenu(menu);
    const punyaLink = validLink(vs.video) || validLink(vs.sop);

    if (!adaResep || !punyaLink) {
        const lanjut = confirm(`⚠️ Menu "${menu}" belum memiliki Resep atau Video/SOP lengkap.\n\nIngin melengkapinya sekarang?`);
        if (lanjut) {
            closeInputModal();
            setTimeout(() => {
                openAdminModal(); // Buka login lagi
                document.getElementById('adminPassword').value = ADMIN_PASSWORD;
                verifyAdmin(); // Auto login
                switchAdminTab('resep'); // Arahkan ke tab Resep
                document.getElementById('rMenu').value = menu; // Auto isi nama menu
            }, 500);
            return;
        }
    }

    simpanData('addJadwal', {hari: document.getElementById('jHari').value, komponen: document.getElementById('jKomponen').value, menu: menu});
}
function simpanResep() {
    const menu = document.getElementById('rMenu').value.trim();
    const card = document.getElementById('rCard').value.trim();
    const items = [1,2,3,4,5].map(i => document.getElementById('rItem'+i).value).filter(v => v && v.trim() !== "");
    if (!menu || !card || items.length === 0) return alert("Lengkapi Nama Menu, Kartu, dan minimal 1 Langkah!");
    simpanData('addResep', { menu: menu, card: card, items: items });
}
